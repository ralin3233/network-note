{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u7db2\u8def\u8ab2\u7a0b\u7b46\u8a18\uff1a\u5be6\u9ad4\u5c64\u8207\u8cc7\u6599\u9023\u63a5\u5c64","text":"<p>\u9019\u4efd\u7b46\u8a18\u6574\u7406\u81ea\u8ab2\u5802\u5167\u5bb9\uff0c\u76ee\u6a19\u662f\u8b93\u6c92\u6709\u4e0a\u904e\u9019\u5802\u8ab2\u7684\u4eba\uff0c\u5149\u770b\u9019\u4efd\u7b46\u8a18\u4e5f\u80fd\u7406\u89e3\u5be6\u9ad4\u5c64 (Physical Layer) \u8207\u8cc7\u6599\u9023\u63a5\u5c64 (Data Link Layer) \u7684\u6838\u5fc3\u6982\u5ff5\u3002</p>"},{"location":"#_2","title":"\u600e\u9ebc\u8b80\u9019\u4efd\u7b46\u8a18","text":"<ul> <li>\u6bcf\u500b\u7ae0\u7bc0\u5148\u8b1b\u300c\u9019\u662f\u4ec0\u9ebc\u3001\u70ba\u4ec0\u9ebc\u9700\u8981\u5b83\u300d\uff0c\u518d\u9032\u5165\u6280\u8853\u7d30\u7bc0</li> <li>\u6709\u516c\u5f0f\u7684\u5730\u65b9\uff08CRC\u3001Hamming Code\uff09\u6703\u9644\u4e0a\u4e00\u6b65\u6b65\u7684\u8a08\u7b97\u7bc4\u4f8b</li> <li>\u5716\u7247\u76e1\u91cf\u53d6\u4ee3\u6587\u5b57\u63cf\u8ff0\u2014\u2014\u8a0a\u865f\u6ce2\u5f62\u3001frame \u683c\u5f0f\u9019\u985e\u6771\u897f\u7528\u770b\u7684\u6bd4\u7528\u8b80\u7684\u5feb\u5f88\u591a</li> </ul>"},{"location":"#_3","title":"\u7ae0\u7bc0\u5c0e\u89bd","text":""},{"location":"#physical-layer","title":"\u5be6\u9ad4\u5c64 Physical Layer","text":"<p>\u8ca0\u8cac\u628a\u300c\u4f4d\u5143\u300d\u8b8a\u6210\u5be6\u969b\u53ef\u4ee5\u5728\u5a92\u4ecb\u4e0a\u50b3\u9001\u7684\u8a0a\u865f\u3002</p>"},{"location":"#data-link-layer","title":"\u8cc7\u6599\u9023\u63a5\u5c64 Data Link Layer","text":"<p>\u8ca0\u8cac\u628a\u4f4d\u5143\u7d44\u7e54\u6210\u6709\u7d50\u69cb\u7684\u6846 (frame)\uff0c\u4e26\u8655\u7406\u932f\u8aa4\u5075\u6e2c\u3001\u6d41\u91cf\u63a7\u5236\u3002</p> <p>\u64b0\u5beb\u4e2d</p> <p>\u9019\u4efd\u7b46\u8a18\u6b63\u5728\u6301\u7e8c\u88dc\u5145\uff0c\u6b61\u8fce\u56de\u5831\u932f\u8aa4\u6216\u4e0d\u6e05\u695a\u7684\u5730\u65b9\u3002</p>"},{"location":"data-link-layer/","title":"\u8cc7\u6599\u9023\u63a5\u5c64 Data Link Layer \u6982\u8ad6","text":""},{"location":"data-link-layer/#_1","title":"\u9019\u4e00\u5c64\u5728\u505a\u4ec0\u9ebc","text":"<p>\u5be6\u9ad4\u5c64\u53ea\u8ca0\u8cac\u50b3\u9001\u539f\u59cb\u7684\u4f4d\u5143\u6d41\uff0c\u4e0d\u4fdd\u8b49\u6b63\u78ba\u6027\u3001\u4e5f\u4e0d\u77e5\u9053\u8cc7\u6599\u7684\u908a\u754c\u5728\u54ea\u3002\u8cc7\u6599\u9023\u63a5\u5c64\u7684\u5de5\u4f5c\u5c31\u662f\u5728\u9019\u4e4b\u4e0a\u52a0\u4e00\u5c64\u300c\u7d50\u69cb\u300d\u8207\u300c\u53ef\u9760\u6027\u300d\uff1a</p> <ul> <li>\u628a\u4f4d\u5143\u6d41\u5207\u5206\u6210\u6709\u610f\u7fa9\u7684\u6846 (frame)</li> <li>\u5075\u6e2c\uff08\u751a\u81f3\u66f4\u6b63\uff09\u50b3\u8f38\u904e\u7a0b\u4e2d\u7684\u932f\u8aa4</li> <li>\u63a7\u5236\u50b3\u9001\u901f\u5ea6\uff0c\u907f\u514d\u63a5\u6536\u7aef\u4f86\u4e0d\u53ca\u8655\u7406</li> <li>\u5728\u540c\u4e00\u5a92\u4ecb\u4e0a\u4ef2\u88c1\u591a\u53f0\u88dd\u7f6e\u7684\u5b58\u53d6\u6b0a\uff08MAC \u5b50\u5c64\uff09</li> </ul>"},{"location":"data-link-layer/#_2","title":"\u672c\u7ae0\u91cd\u9ede","text":"\u4e3b\u984c \u4e00\u53e5\u8a71\u8aaa\u660e \u6210\u6846 Framing \u600e\u9ebc\u628a\u9023\u7e8c\u7684\u4f4d\u5143\u5207\u6210\u4e00\u500b\u500b\u6846 \u932f\u8aa4\u5075\u6e2c\u8207\u66f4\u6b63 \u600e\u9ebc\u77e5\u9053\u8cc7\u6599\u6709\u6c92\u6709\u50b3\u932f\uff0c\u751a\u81f3\u4fee\u597d\u5b83 \u6d41\u91cf\u63a7\u5236 \u600e\u9ebc\u907f\u514d\u50b3\u9001\u7aef\u704c\u7206\u63a5\u6536\u7aef MAC \u5b50\u5c64 \u591a\u53f0\u88dd\u7f6e\u5171\u7528\u5a92\u4ecb\u6642\u600e\u9ebc\u5206\u914d\u5b58\u53d6\u6b0a \u5e38\u898b\u5354\u5b9a Ethernet frame \u683c\u5f0f\u8207 MAC \u4f4d\u5740"},{"location":"data-link-layer/error-detection/","title":"\u932f\u8aa4\u5075\u6e2c\u8207\u66f4\u6b63","text":"<p>\u8a0a\u865f\u5728\u50b3\u8f38\u904e\u7a0b\u4e2d\u53ef\u80fd\u56e0\u70ba\u96dc\u8a0a\u3001\u5e72\u64fe\u800c\u51fa\u932f\u3002\u9019\u4e00\u7bc0\u4ecb\u7d39\u600e\u9ebc\u300c\u767c\u73fe\u300d\u932f\u8aa4\uff08\u932f\u8aa4\u5075\u6e2c\uff09\uff0c\u751a\u81f3\u300c\u4fee\u597d\u300d\u932f\u8aa4\uff08\u932f\u8aa4\u66f4\u6b63\uff09\u3002</p>"},{"location":"data-link-layer/error-detection/#parity-bit","title":"Parity Bit\uff08\u5947\u5076\u6821\u9a57\uff09","text":"<p>\u5728\u8cc7\u6599\u5f8c\u9762\u52a0\u4e00\u500b\u4f4d\u5143\uff0c\u8b93\u6574\u7d44\u8cc7\u6599\u4e2d 1 \u7684\u500b\u6578\u7b26\u5408\u5947\u6578\uff08\u5947\u6821\u9a57\uff09\u6216\u5076\u6578\uff08\u5076\u6821\u9a57\uff09\u3002</p> <p>\u7bc4\u4f8b\uff08\u5076\u6821\u9a57\uff09\uff1a\u8cc7\u6599 <code>1011000</code>\uff0c1 \u7684\u500b\u6578\u662f 3\uff08\u5947\u6578\uff09\uff0c\u6240\u4ee5\u88dc\u4e00\u500b <code>1</code> \u8b93\u7e3d\u6578\u8b8a\u5076\u6578 \u2192 \u50b3\u9001 <code>10110001</code></p> <ul> <li>\u512a\u9ede\uff1a\u7c21\u55ae</li> <li>\u7f3a\u9ede\uff1a\u53ea\u80fd\u5075\u6e2c\u5947\u6578\u500b\u4f4d\u5143\u932f\u8aa4\uff0c\u5169\u500b\u4f4d\u5143\u540c\u6642\u51fa\u932f\u5c31\u6293\u4e0d\u5230</li> </ul>"},{"location":"data-link-layer/error-detection/#crc-cyclic-redundancy-check","title":"CRC (Cyclic Redundancy Check)","text":"<p>CRC \u7528\u591a\u9805\u5f0f\u9664\u6cd5\u7684\u6982\u5ff5\uff0c\u5728\u8cc7\u6599\u5f8c\u9762\u9644\u52a0\u4e00\u6bb5\u300c\u9918\u6578\u300d\u7576\u4f5c\u6aa2\u67e5\u78bc\u3002</p> <p>\u7bc4\u4f8b\uff1a\u8cc7\u6599 <code>1101011011</code>\uff0c\u751f\u6210\u591a\u9805\u5f0f\u5c0d\u61c9\u7684\u4f4d\u5143\u5e8f\u5217 <code>10011</code>\uff084 \u4f4d\u5143\u7684 CRC\uff0c\u591a\u9805\u5f0f\u9577\u5ea6\u9700\u70ba 5\uff09</p> <ol> <li>\u5728\u8cc7\u6599\u5f8c\u9762\u88dc 4 \u500b 0\uff1a<code>11010110110000</code></li> <li>\u7528\u751f\u6210\u591a\u9805\u5f0f <code>10011</code> \u5c0d\u9019\u4e32\u8cc7\u6599\u505a\u6a21\u4e8c\u9664\u6cd5\uff08\u5176\u5be6\u5c31\u662f\u91cd\u8907 XOR\uff09\uff1a</li> </ol> <pre><code>11010110110000\n10011\n-----\n01001110110000\n 10011\n -----\n 0000101110000\n     10011\n     -----\n     000111 0000\n        ...\uff08\u6301\u7e8c XOR \u76f4\u5230\u9664\u5b8c\uff09\n</code></pre> <ol> <li>\u6700\u5f8c\u5269\u4e0b\u7684\u9918\u6578\uff08\u5047\u8a2d\u7b97\u51fa\u4f86\u662f <code>1110</code>\uff09\u5c31\u662f CRC \u6aa2\u67e5\u78bc\uff0c\u9644\u52a0\u5230\u539f\u59cb\u8cc7\u6599\u5f8c\u9762\u9001\u51fa\uff1a<code>11010110111110</code></li> <li>\u63a5\u6536\u7aef\u6536\u5230\u5f8c\uff0c\u7528\u540c\u4e00\u500b\u751f\u6210\u591a\u9805\u5f0f\u505a\u540c\u6a23\u7684\u9664\u6cd5\uff0c\u5982\u679c\u9918\u6578\u662f <code>0000</code> \u4ee3\u8868\u6c92\u6709\u932f\u8aa4</li> </ol> <ul> <li>\u512a\u9ede\uff1a\u5075\u932f\u80fd\u529b\u9060\u512a\u65bc parity bit\uff0c\u786c\u9ad4\u5be6\u4f5c\uff08\u7528 shift register\uff09\u6548\u7387\u9ad8</li> <li>\u5e38\u898b\u61c9\u7528\uff1a\u4e59\u592a\u7db2\u8def\u3001USB\u3001\u5132\u5b58\u88dd\u7f6e</li> </ul>"},{"location":"data-link-layer/error-detection/#hamming-code","title":"Hamming Code\uff08\u6f22\u660e\u78bc\uff0c\u53ef\u66f4\u6b63\u932f\u8aa4\uff09","text":"<p>Parity bit \u548c CRC \u53ea\u80fd\u300c\u5075\u6e2c\u300d\u932f\u8aa4\uff0cHamming Code \u53ef\u4ee5\u76f4\u63a5\u300c\u5b9a\u4f4d\u4e26\u4fee\u6b63\u300d\u55ae\u4e00\u4f4d\u5143\u932f\u8aa4\u3002</p> <p>\u6838\u5fc3\u6982\u5ff5\uff1a\u5728\u8cc7\u6599\u4e2d\u63d2\u5165\u591a\u500b\u6821\u9a57\u4f4d\u5143\uff0c\u6bcf\u500b\u6821\u9a57\u4f4d\u5143\u8ca0\u8cac\u6aa2\u67e5\u8cc7\u6599\u4e2d\u7279\u5b9a\u7684\u4e00\u7d44\u4f4d\u5143\uff08\u4f9d\u7167\u4f4d\u7f6e\u7684\u4e8c\u9032\u4f4d\u8868\u793a\u6c7a\u5b9a\uff09\u3002</p> <p>\u7bc4\u4f8b\uff1a4 \u4f4d\u5143\u8cc7\u6599 <code>1011</code> \u7de8\u78bc\u6210 Hamming(7,4)</p> <ol> <li>\u6821\u9a57\u4f4d\u5143\u653e\u5728 2 \u7684\u51aa\u6b21\u4f4d\u7f6e\uff1a\u4f4d\u7f6e 1, 2, 4 \u662f\u6821\u9a57\u4f4d\u5143 (p1, p2, p4)\uff0c\u4f4d\u7f6e 3, 5, 6, 7 \u653e\u8cc7\u6599\u4f4d\u5143 <code>d1 d2 d3 d4</code> = <code>1 0 1 1</code></li> </ol> \u4f4d\u7f6e 1 2 3 4 5 6 7 \u5167\u5bb9 p1 p2 d1=1 p4 d2=0 d3=1 d4=1 <ol> <li>\u8a08\u7b97\u6bcf\u500b\u6821\u9a57\u4f4d\u5143\uff08\u5076\u6821\u9a57\uff0c\u6db5\u84cb\u4f4d\u7f6e\u7684\u4e8c\u9032\u4f4d\u8868\u793a\u4e2d\u8a72 bit \u70ba 1 \u7684\u6240\u6709\u4f4d\u7f6e\uff09\uff1a</li> <li>p1 \u6aa2\u67e5\u4f4d\u7f6e 1,3,5,7 \u2192 1,1,0,1 \u2192 1 \u7684\u500b\u6578\u662f 3\uff08\u5947\u6578\uff09\u2192 p1 = 1\uff08\u88dc\u6210\u5076\u6578\uff09</li> <li>p2 \u6aa2\u67e5\u4f4d\u7f6e 2,3,6,7 \u2192 p2,1,1,1 \u2192 \u8b93\u7e3d\u6578\u5076\u6578 \u2192 p2 = 1</li> <li> <p>p4 \u6aa2\u67e5\u4f4d\u7f6e 4,5,6,7 \u2192 p4,0,1,1 \u2192 \u8b93\u7e3d\u6578\u5076\u6578 \u2192 p4 = 0</p> </li> <li> <p>\u6700\u7d42\u50b3\u9001\uff1a<code>1 1 1 0 0 1 1</code>\uff08\u4f4d\u7f6e 1~7\uff09</p> </li> </ol> <p>\u63a5\u6536\u7aef\u5982\u4f55\u6293\u51fa\u932f\u8aa4\u4f4d\u7f6e\uff1a\u91cd\u65b0\u8a08\u7b97 p1\u3001p2\u3001p4 \u7684\u6821\u9a57\u7d50\u679c\uff0c\u628a\u7d50\u679c\u7d44\u6210\u4e8c\u9032\u4f4d\u6578\u5b57\uff0c\u9019\u500b\u6578\u5b57\u5c31\u662f\u51fa\u932f\u7684\u4f4d\u7f6e\uff080 \u4ee3\u8868\u6c92\u932f\uff09\u3002</p>"},{"location":"data-link-layer/error-detection/#_2","title":"\u4e09\u7a2e\u65b9\u6cd5\u6bd4\u8f03","text":"\u65b9\u6cd5 \u80fd\u5075\u6e2c \u80fd\u66f4\u6b63 \u984d\u5916\u958b\u92b7 Parity Bit \u5947\u6578\u500b\u4f4d\u5143\u932f\u8aa4 \u5426 \u6975\u4f4e CRC \u591a\u4f4d\u5143\u932f\u8aa4\uff08\u80fd\u529b\u8996\u751f\u6210\u591a\u9805\u5f0f\u800c\u5b9a\uff09 \u5426\uff08\u53ea\u80fd\u5075\u6e2c\uff09 \u4f4e-\u4e2d Hamming Code \u53ef\u5075\u6e2c\u5230\u96d9\u4f4d\u5143\u932f\u8aa4 \u53ef\u66f4\u6b63\u55ae\u4f4d\u5143\u932f\u8aa4 \u4e2d"},{"location":"data-link-layer/flow-control/","title":"\u6d41\u91cf\u63a7\u5236 Flow Control","text":""},{"location":"data-link-layer/flow-control/#_1","title":"\u70ba\u4ec0\u9ebc\u9700\u8981\u6d41\u91cf\u63a7\u5236","text":"<p>\u5982\u679c\u50b3\u9001\u7aef\u901f\u5ea6\u6bd4\u63a5\u6536\u7aef\u8655\u7406\u901f\u5ea6\u5feb\uff0c\u63a5\u6536\u7aef\u7684\u7de9\u885d\u5340\u6703\u88ab\u585e\u7206\uff0c\u5c0e\u81f4\u8cc7\u6599\u907a\u5931\u3002\u6d41\u91cf\u63a7\u5236\u5c31\u662f\u5354\u8abf\u5169\u7aef\u901f\u5ea6\u7684\u6a5f\u5236\u3002</p>"},{"location":"data-link-layer/flow-control/#stop-and-wait","title":"Stop-and-Wait","text":"<p>\u50b3\u9001\u7aef\u9001\u51fa\u4e00\u500b\u6846\u5f8c\u5c31\u505c\u4e0b\u4f86\uff0c\u7b49\u63a5\u6536\u7aef\u56de\u8986\u78ba\u8a8d (ACK) \u624d\u9001\u4e0b\u4e00\u500b\u6846\u3002</p> <ul> <li>\u512a\u9ede\uff1a\u7c21\u55ae</li> <li>\u7f3a\u9ede\uff1a\u6548\u7387\u5dee\uff0c\u5c24\u5176\u5728\u50b3\u8f38\u5ef6\u9072\u9ad8\u7684\u7db2\u8def\u4e0a\uff0c\u5927\u90e8\u5206\u6642\u9593\u90fd\u5728\u300c\u7b49\u300d</li> </ul>"},{"location":"data-link-layer/flow-control/#sliding-window","title":"Sliding Window\uff08\u6ed1\u52d5\u7a97\u53e3\uff09","text":"<p>\u5141\u8a31\u50b3\u9001\u7aef\u5728\u6536\u5230\u78ba\u8a8d\u4e4b\u524d\uff0c\u9023\u7e8c\u9001\u51fa\u591a\u500b\u6846\uff08\u7a97\u53e3\u5927\u5c0f\u6c7a\u5b9a\u53ef\u4ee5\u9023\u9001\u5e7e\u500b\uff09\u3002</p> <ul> <li>\u512a\u9ede\uff1a\u5927\u5e45\u63d0\u5347\u50b3\u8f38\u6548\u7387\uff0c\u4e0d\u7528\u6bcf\u500b\u6846\u90fd\u7b49\u78ba\u8a8d</li> <li>\u5e38\u898b\u5ef6\u4f38\uff1aGo-Back-N\u3001Selective Repeat\uff08\u8655\u7406\u6846\u907a\u5931\u6216\u51fa\u932f\u6642\u7684\u91cd\u50b3\u7b56\u7565\u5dee\u7570\uff09</li> </ul> <p>\u8ab2\u5802\u88dc\u5145</p> <p>\u9019\u88e1\u53ef\u4ee5\u88dc\u5145\u8001\u5e2b\u662f\u5426\u6709\u6bd4\u8f03 Stop-and-Wait \u8ddf Sliding Window \u7684\u6548\u7387\u5dee\u7570\uff08\u4f8b\u5982\u7528\u516c\u5f0f\u6216\u5716\u8868\uff09</p>"},{"location":"data-link-layer/framing/","title":"\u6210\u6846 Framing","text":""},{"location":"data-link-layer/framing/#_1","title":"\u70ba\u4ec0\u9ebc\u9700\u8981\u6210\u6846","text":"<p>\u5be6\u9ad4\u5c64\u9001\u51fa\u4f86\u7684\u53ea\u662f\u4e00\u9577\u4e32\u4f4d\u5143\uff0c\u63a5\u6536\u7aef\u4e0d\u77e5\u9053\u300c\u4e00\u500b\u8a0a\u606f\u5f9e\u54ea\u88e1\u958b\u59cb\u3001\u5230\u54ea\u88e1\u7d50\u675f\u300d\u3002\u6210\u6846\u5c31\u662f\u5728\u4f4d\u5143\u6d41\u4e2d\u6a19\u51fa\u908a\u754c\uff0c\u8b93\u63a5\u6536\u7aef\u80fd\u6b63\u78ba\u5207\u51fa\u4e00\u500b\u500b\u6846 (frame)\u3002</p>"},{"location":"data-link-layer/framing/#_2","title":"\u5e38\u898b\u6210\u6846\u65b9\u6cd5","text":""},{"location":"data-link-layer/framing/#character-count","title":"\u5b57\u5143\u8a08\u6578 (Character Count)","text":"<p>\u5728\u6846\u7684\u958b\u982d\u653e\u4e00\u500b\u6578\u5b57\uff0c\u8aaa\u660e\u9019\u500b\u6846\u6709\u591a\u9577\u3002</p>"},{"location":"data-link-layer/framing/#bit-stuffing","title":"\u4f4d\u5143\u586b\u5145 (Bit Stuffing)","text":"<p>\u7528\u7279\u5b9a\u7684\u4f4d\u5143\u5e8f\u5217\uff08\u5982 <code>01111110</code>\uff09\u7576\u4f5c\u6846\u7684\u8d77\u59cb/\u7d50\u675f\u6a19\u8a18\uff0c\u4e26\u5728\u8cc7\u6599\u4e2d\u51fa\u73fe\u985e\u4f3c\u5e8f\u5217\u6642\u63d2\u5165\u984d\u5916\u4f4d\u5143\u907f\u514d\u6df7\u6dc6\u3002</p>"},{"location":"data-link-layer/framing/#byte-stuffing","title":"\u5b57\u5143\u586b\u5145 (Byte Stuffing)","text":"<p>\u5716\u89e3\u5efa\u8b70</p> <p>\u4f4d\u5143\u586b\u5145\u53ef\u4ee5\u653e\u4e00\u500b\u5177\u9ad4\u4f8b\u5b50\uff1a\u539f\u59cb\u8cc7\u6599 \u2192 \u63d2\u5165 stuffing bit \u5f8c\u7684\u8cc7\u6599 \u2192 \u63a5\u6536\u7aef\u5982\u4f55\u9084\u539f</p>"},{"location":"data-link-layer/mac-sublayer/","title":"MAC \u5b50\u5c64 Medium Access Control","text":""},{"location":"data-link-layer/mac-sublayer/#mac","title":"\u70ba\u4ec0\u9ebc\u9700\u8981 MAC \u5b50\u5c64","text":"<p>\u7576\u591a\u53f0\u88dd\u7f6e\u5171\u7528\u540c\u4e00\u500b\u50b3\u8f38\u5a92\u4ecb\uff08\u4f8b\u5982\u540c\u4e00\u689d\u4e59\u592a\u7db2\u8def\u7dda\u3001\u540c\u4e00\u500b\u7121\u7dda\u983b\u9053\uff09\u6642\uff0c\u5fc5\u9808\u8981\u6709\u898f\u5247\u6c7a\u5b9a\u300c\u8ab0\u73fe\u5728\u53ef\u4ee5\u50b3\u9001\u8cc7\u6599\u300d\uff0c\u5426\u5247\u8a0a\u865f\u6703\u4e92\u76f8\u5e72\u64fe\uff08\u78b0\u649e\uff09\u3002</p>"},{"location":"data-link-layer/mac-sublayer/#csmacd-carrier-sense-multiple-access-with-collision-detection","title":"CSMA/CD (Carrier Sense Multiple Access with Collision Detection)","text":"<p>\u7528\u5728\u6709\u7dda\u4e59\u592a\u7db2\u8def\uff08\u50b3\u7d71\u532f\u6d41\u6392\u67b6\u69cb\uff09\u3002</p> <ol> <li>\u50b3\u9001\u524d\u5148\u300c\u807d\u300d\u5a92\u4ecb\u662f\u5426\u6709\u5176\u4ed6\u88dd\u7f6e\u5728\u50b3\uff08Carrier Sense\uff09</li> <li>\u5982\u679c\u6c92\u6709\uff0c\u5c31\u958b\u59cb\u50b3\u9001\uff0c\u540c\u6642\u6301\u7e8c\u76e3\u807d\u662f\u5426\u767c\u751f\u78b0\u649e</li> <li>\u5982\u679c\u5075\u6e2c\u5230\u78b0\u649e\uff0c\u96d9\u65b9\u90fd\u505c\u6b62\u50b3\u9001\uff0c\u5404\u81ea\u7b49\u5f85\u4e00\u6bb5\u96a8\u6a5f\u6642\u9593\u5f8c\u91cd\u8a66\uff08\u907f\u514d\u540c\u6642\u518d\u6b21\u78b0\u649e\uff09</li> </ol>"},{"location":"data-link-layer/mac-sublayer/#csmaca-carrier-sense-multiple-access-with-collision-avoidance","title":"CSMA/CA (Carrier Sense Multiple Access with Collision Avoidance)","text":"<p>\u7528\u5728\u7121\u7dda\u7db2\u8def\uff08\u56e0\u70ba\u7121\u7dda\u74b0\u5883\u4e0b\u78b0\u649e\u4e0d\u5bb9\u6613\u300c\u5075\u6e2c\u300d\uff0c\u53ea\u80fd\u76e1\u91cf\u300c\u907f\u514d\u300d\uff09\u3002</p>"},{"location":"data-link-layer/mac-sublayer/#_1","title":"\u5169\u8005\u6bd4\u8f03","text":"CSMA/CD CSMA/CA \u61c9\u7528\u5834\u666f \u6709\u7dda\u4e59\u592a\u7db2\u8def \u7121\u7dda\u7db2\u8def (Wi-Fi) \u6838\u5fc3\u7b56\u7565 \u5075\u6e2c\u78b0\u649e\u5f8c\u91cd\u50b3 \u4e8b\u5148\u907f\u514d\u78b0\u649e\u767c\u751f"},{"location":"data-link-layer/protocols/","title":"\u5e38\u898b\u5354\u5b9a","text":""},{"location":"data-link-layer/protocols/#ethernet-frame","title":"Ethernet Frame \u683c\u5f0f","text":"\u6b04\u4f4d \u9577\u5ea6 \u7528\u9014 Preamble 7 bytes \u8b93\u63a5\u6536\u7aef\u540c\u6b65\u6642\u8108 Destination MAC 6 bytes \u76ee\u7684\u88dd\u7f6e\u4f4d\u5740 Source MAC 6 bytes \u4f86\u6e90\u88dd\u7f6e\u4f4d\u5740 Type/Length 2 bytes \u4e0a\u5c64\u5354\u5b9a\u985e\u578b Data 46-1500 bytes \u5be6\u969b\u8cc7\u6599 CRC 4 bytes \u932f\u8aa4\u5075\u6e2c\u78bc"},{"location":"data-link-layer/protocols/#mac","title":"MAC \u4f4d\u5740","text":"<ul> <li>48 \u4f4d\u5143\uff086 bytes\uff09\uff0c\u901a\u5e38\u5beb\u6210 12 \u4f4d\u5341\u516d\u9032\u4f4d\u6578\u5b57\uff0c\u5982 <code>00:1A:2B:3C:4D:5E</code></li> <li>\u524d 3 bytes \u662f\u5ee0\u5546\u4ee3\u78bc (OUI)\uff0c\u5f8c 3 bytes \u7531\u5ee0\u5546\u81ea\u884c\u5206\u914d</li> <li>\u7406\u8ad6\u4e0a\u5168\u7403\u552f\u4e00\uff0c\u71d2\u9304\u5728\u7db2\u8def\u5361\u4e0a</li> </ul>"},{"location":"physical-layer/","title":"\u5be6\u9ad4\u5c64 Physical Layer \u6982\u8ad6","text":""},{"location":"physical-layer/#_1","title":"\u9019\u4e00\u5c64\u5728\u505a\u4ec0\u9ebc","text":"<p>\u5be6\u9ad4\u5c64\u662f OSI \u6a21\u578b\u7684\u6700\u5e95\u5c64\uff0c\u8ca0\u8cac\u628a\u4e0a\u5c64\u50b3\u4f86\u7684\u300c\u4f4d\u5143 (bit)\u300d\u8f49\u63db\u6210\u53ef\u4ee5\u5728\u5be6\u969b\u5a92\u4ecb\uff08\u96fb\u7dda\u3001\u5149\u7e96\u3001\u7121\u7dda\u96fb\u6ce2\uff09\u4e0a\u50b3\u8f38\u7684\u7269\u7406\u8a0a\u865f\u3002\u5b83\u4e0d\u95dc\u5fc3\u8cc7\u6599\u7684\u610f\u7fa9\uff0c\u53ea\u7ba1\u628a 0 \u548c 1 \u9001\u5230\u5c0d\u9762\u53bb\u3002</p>"},{"location":"physical-layer/#_2","title":"\u70ba\u4ec0\u9ebc\u9700\u8981\u55ae\u7368\u4e00\u5c64\u4f86\u8655\u7406\u9019\u4ef6\u4e8b","text":"<p>\u4e0a\u5c64\uff08\u8cc7\u6599\u9023\u63a5\u5c64\u4ee5\u4e0a\uff09\u53ea\u5728\u4e4e\u300c\u908f\u8f2f\u4e0a\u7684\u4f4d\u5143\u300d\uff0c\u4f46\u73fe\u5be6\u4e16\u754c\u7684\u50b3\u8f38\u5a92\u4ecb\u6709\u5404\u81ea\u7684\u7269\u7406\u9650\u5236\uff1a</p> <ul> <li>\u96fb\u8a0a\u865f\u6703\u8870\u6e1b\u3001\u6703\u88ab\u5e72\u64fe</li> <li>\u5149\u8a0a\u865f\u9700\u8981\u4e0d\u540c\u7684\u6536\u767c\u5143\u4ef6</li> <li>\u7121\u7dda\u96fb\u6ce2\u8981\u8003\u616e\u983b\u7387\u3001\u5929\u7dda\u8a2d\u8a08</li> </ul> <p>\u5be6\u9ad4\u5c64\u628a\u9019\u4e9b\u300c\u600e\u9ebc\u628a\u4f4d\u5143\u8b8a\u6210\u7269\u7406\u8a0a\u865f\u300d\u7684\u7d30\u7bc0\u5c01\u88dd\u8d77\u4f86\uff0c\u8b93\u4e0a\u5c64\u4e0d\u7528\u7ba1\u786c\u9ad4\u5dee\u7570\u3002</p>"},{"location":"physical-layer/#_3","title":"\u672c\u7ae0\u91cd\u9ede","text":"\u4e3b\u984c \u4e00\u53e5\u8a71\u8aaa\u660e \u50b3\u8f38\u5a92\u4ecb \u8a0a\u865f\u5be6\u969b\u8dd1\u5728\u4ec0\u9ebc\u6771\u897f\u4e0a\uff08\u9285\u7dda\u3001\u5149\u7e96\u2026\uff09 \u8a0a\u865f\u8207\u7de8\u78bc \u4f4d\u5143\u600e\u9ebc\u8b8a\u6210\u8a0a\u865f\u6ce2\u5f62 \u8abf\u8b8a\u6280\u8853 \u8a0a\u865f\u600e\u9ebc\u758a\u52a0\u5230\u8f09\u6ce2\u4e0a\u50b3\u9001 \u50b3\u8f38\u6a21\u5f0f \u8cc7\u6599\u50b3\u8f38\u7684\u65b9\u5411\u8207\u4e26\u5217/\u4e32\u5217\u65b9\u5f0f \u5e38\u898b\u6a19\u6e96 \u696d\u754c\u5be6\u969b\u5728\u7528\u7684\u898f\u683c"},{"location":"physical-layer/media/","title":"\u50b3\u8f38\u5a92\u4ecb","text":"<p>\u50b3\u8f38\u5a92\u4ecb\u5206\u6210\u300c\u5c0e\u5411\u5f0f\u300d(guided\uff0c\u8a0a\u865f\u6cbf\u8457\u5be6\u9ad4\u8def\u5f91\u8d70) \u548c\u300c\u975e\u5c0e\u5411\u5f0f\u300d(unguided\uff0c\u8a0a\u865f\u5728\u7a7a\u6c23\u4e2d\u50b3\u64ad)\u3002</p>"},{"location":"physical-layer/media/#_2","title":"\u5c0e\u5411\u5f0f\u5a92\u4ecb","text":""},{"location":"physical-layer/media/#twisted-pair","title":"\u96d9\u7d5e\u7dda (Twisted Pair)","text":""},{"location":"physical-layer/media/#coaxial-cable","title":"\u540c\u8ef8\u96fb\u7e9c (Coaxial Cable)","text":""},{"location":"physical-layer/media/#fiber-optic","title":"\u5149\u7e96 (Fiber Optic)","text":""},{"location":"physical-layer/media/#_3","title":"\u975e\u5c0e\u5411\u5f0f\u5a92\u4ecb","text":""},{"location":"physical-layer/media/#_4","title":"\u6bd4\u8f03\u8868","text":"\u5a92\u4ecb \u983b\u5bec \u6297\u5e72\u64fe \u6210\u672c \u9069\u7528\u5834\u666f \u96d9\u7d5e\u7dda \u4f4e-\u4e2d \u5dee \u4f4e \u5340\u57df\u7db2\u8def\u3001\u96fb\u8a71\u7dda \u540c\u8ef8\u96fb\u7e9c \u4e2d \u4e2d \u4e2d \u6709\u7dda\u96fb\u8996\u3001\u65e9\u671f\u4e59\u592a\u7db2\u8def \u5149\u7e96 \u9ad8 \u6975\u4f73 \u9ad8 \u9aa8\u5e79\u7db2\u8def\u3001\u9577\u8ddd\u96e2\u50b3\u8f38 <p>\u8ab2\u5802\u88dc\u5145</p> <p>\u9019\u88e1\u53ef\u4ee5\u653e\u4e0a\u8ab2\u63d0\u5230\u7684\u5be6\u969b\u6848\u4f8b\u6216\u8001\u5e2b\u5f37\u8abf\u7684\u91cd\u9ede</p>"},{"location":"physical-layer/modulation/","title":"\u8abf\u8b8a\u6280\u8853","text":""},{"location":"physical-layer/modulation/#_2","title":"\u70ba\u4ec0\u9ebc\u9700\u8981\u8abf\u8b8a","text":"<p>\u6578\u4f4d\u8a0a\u865f\u6c92\u8fa6\u6cd5\u76f4\u63a5\u5728\u67d0\u4e9b\u5a92\u4ecb\uff08\u4f8b\u5982\u7121\u7dda\u96fb\u6ce2\u3001\u96fb\u8a71\u7dda\uff09\u4e0a\u6709\u6548\u50b3\u8f38\uff0c\u9700\u8981\u5148\u300c\u758a\u52a0\u300d\u5230\u4e00\u500b\u8f09\u6ce2 (carrier wave) \u4e0a\uff0c\u9019\u500b\u904e\u7a0b\u53eb\u8abf\u8b8a\u3002</p>"},{"location":"physical-layer/modulation/#_3","title":"\u4e09\u7a2e\u57fa\u672c\u8abf\u8b8a\u65b9\u5f0f","text":""},{"location":"physical-layer/modulation/#ask-amplitude-shift-keying","title":"ASK (Amplitude Shift Keying, \u632f\u5e45\u504f\u79fb\u8abf\u8b8a)","text":""},{"location":"physical-layer/modulation/#fsk-frequency-shift-keying","title":"FSK (Frequency Shift Keying, \u983b\u7387\u504f\u79fb\u8abf\u8b8a)","text":""},{"location":"physical-layer/modulation/#psk-phase-shift-keying","title":"PSK (Phase Shift Keying, \u76f8\u4f4d\u504f\u79fb\u8abf\u8b8a)","text":"<p>\u5716\u89e3\u5efa\u8b70</p> <p>\u756b\u51fa\u8f09\u6ce2 + \u4e09\u7a2e\u8abf\u8b8a\u5f8c\u6ce2\u5f62\u7684\u5c0d\u7167\u5716\uff0c\u8b93\u8b80\u8005\u4e00\u773c\u770b\u51fa\u5dee\u7570</p>"},{"location":"physical-layer/modulation/#_4","title":"\u6bd4\u8f03\u8868","text":"\u8abf\u8b8a\u65b9\u5f0f \u6539\u8b8a\u7684\u7269\u7406\u91cf \u6297\u5e72\u64fe\u80fd\u529b ASK \u632f\u5e45 \u5dee FSK \u983b\u7387 \u4e2d PSK \u76f8\u4f4d \u597d"},{"location":"physical-layer/signal-encoding/","title":"\u8a0a\u865f\u8207\u7de8\u78bc","text":""},{"location":"physical-layer/signal-encoding/#vs","title":"\u985e\u6bd4\u8a0a\u865f vs \u6578\u4f4d\u8a0a\u865f","text":""},{"location":"physical-layer/signal-encoding/#_2","title":"\u70ba\u4ec0\u9ebc\u9700\u8981\u7de8\u78bc","text":"<p>\u5982\u679c\u55ae\u7d14\u7528\u300c\u9ad8\u96fb\u58d3 = 1\uff0c\u4f4e\u96fb\u58d3 = 0\u300d\uff0c\u6703\u9047\u5230\u540c\u6b65\u554f\u984c\uff08\u9023\u7e8c\u4e00\u4e32 1 \u6216 0 \u6642\uff0c\u63a5\u6536\u7aef\u4e0d\u5bb9\u6613\u77e5\u9053\u73fe\u5728\u662f\u7b2c\u5e7e\u500b\u4f4d\u5143\uff09\u3002\u7de8\u78bc\u65b9\u5f0f\u5c31\u662f\u70ba\u4e86\u89e3\u6c7a\u9019\u985e\u554f\u984c\u8a2d\u8a08\u7684\u3002</p>"},{"location":"physical-layer/signal-encoding/#_3","title":"\u5e38\u898b\u7de8\u78bc\u65b9\u5f0f","text":""},{"location":"physical-layer/signal-encoding/#nrz-non-return-to-zero","title":"NRZ (Non-Return-to-Zero)","text":""},{"location":"physical-layer/signal-encoding/#manchester-encoding","title":"Manchester Encoding","text":""},{"location":"physical-layer/signal-encoding/#differential-manchester","title":"Differential Manchester","text":"<p>\u5716\u89e3\u5efa\u8b70</p> <p>\u9019\u88e1\u5f37\u70c8\u5efa\u8b70\u756b\u51fa\u6bcf\u7a2e\u7de8\u78bc\u65b9\u5f0f\u5c0d\u540c\u4e00\u7d44\u4f4d\u5143\u5e8f\u5217\uff08\u4f8b\u5982 <code>1 0 1 1 0 0 1</code>\uff09\u7684\u6ce2\u5f62\u5716\uff0c\u7528\u770b\u7684\u6bd4\u7528\u8b80\u7684\u6e05\u695a\u5f88\u591a</p>"},{"location":"physical-layer/signal-encoding/#_4","title":"\u7de8\u78bc\u65b9\u5f0f\u6bd4\u8f03","text":"\u7de8\u78bc \u81ea\u5e36\u6642\u8108 \u983b\u5bec\u6548\u7387 \u5e38\u898b\u61c9\u7528 NRZ \u5426 \u9ad8 - Manchester \u662f \u4f4e\uff08\u983b\u5bec\u9700\u6c42\u52a0\u500d\uff09 Classic Ethernet Differential Manchester \u662f \u4f4e Token Ring"},{"location":"physical-layer/standards/","title":"\u5e38\u898b\u6a19\u6e96","text":""},{"location":"physical-layer/standards/#rs-232","title":"RS-232","text":""},{"location":"physical-layer/standards/#_2","title":"\u4e59\u592a\u7db2\u8def\u7dda\u6750\u898f\u683c","text":"\u898f\u683c \u6700\u5927\u983b\u5bec \u5e38\u898b\u7528\u9014 Cat5e 1 Gbps \u5bb6\u7528/\u4e00\u822c\u8fa6\u516c\u7db2\u8def Cat6 1-10 Gbps \u8f03\u65b0\u7684\u5340\u57df\u7db2\u8def\u4f48\u7dda Cat6a 10 Gbps \u8cc7\u6599\u4e2d\u5fc3\u3001\u9ad8\u901f\u9700\u6c42"},{"location":"physical-layer/transmission-modes/","title":"\u50b3\u8f38\u6a21\u5f0f","text":""},{"location":"physical-layer/transmission-modes/#_2","title":"\u4f9d\u65b9\u5411\u5206\u985e","text":""},{"location":"physical-layer/transmission-modes/#simplex","title":"\u55ae\u5de5 (Simplex)","text":"<p>\u8cc7\u6599\u53ea\u80fd\u55ae\u65b9\u5411\u50b3\u8f38\u3002</p>"},{"location":"physical-layer/transmission-modes/#half-duplex","title":"\u534a\u96d9\u5de5 (Half Duplex)","text":"<p>\u96d9\u65b9\u90fd\u80fd\u50b3\uff0c\u4f46\u540c\u4e00\u6642\u9593\u53ea\u80fd\u4e00\u65b9\u50b3\u3002</p>"},{"location":"physical-layer/transmission-modes/#full-duplex","title":"\u5168\u96d9\u5de5 (Full Duplex)","text":"<p>\u96d9\u65b9\u53ef\u4ee5\u540c\u6642\u50b3\u9001\u8207\u63a5\u6536\u3002</p>"},{"location":"physical-layer/transmission-modes/#_3","title":"\u4f9d\u4f4d\u5143\u6392\u5217\u5206\u985e","text":""},{"location":"physical-layer/transmission-modes/#serial-transmission","title":"\u4e32\u5217\u50b3\u8f38 (Serial Transmission)","text":"<p>\u4f4d\u5143\u4e00\u500b\u63a5\u4e00\u500b\u50b3\u9001\uff0c\u53ea\u9700\u8981\u4e00\u689d\u50b3\u8f38\u7dda\u3002</p>"},{"location":"physical-layer/transmission-modes/#parallel-transmission","title":"\u4e26\u5217\u50b3\u8f38 (Parallel Transmission)","text":"<p>\u591a\u500b\u4f4d\u5143\u540c\u6642\u900f\u904e\u591a\u689d\u7dda\u50b3\u9001\u3002</p> <p>\u8ab2\u5802\u88dc\u5145</p> <p>\u9019\u88e1\u53ef\u4ee5\u88dc\u5145\u8001\u5e2b\u63d0\u5230\u7684\u5be6\u969b\u6848\u4f8b\uff0c\u4f8b\u5982 USB \u5f9e\u4e26\u5217\u8d70\u5411\u4e32\u5217\u7684\u6b77\u53f2\u539f\u56e0</p>"}]}